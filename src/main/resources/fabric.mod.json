{
	"schemaVersion": 1,
	"id": "pgp-chat",
	"version": "${version}",
	"name": "PGP-Chat",
	"description": "Encrypt your chat messages with PGP!",
	"authors": [
		"hankwly5"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/pgp-chat",
		"sources": "https://github.com/hankwly5/PGP-Chat"
	},
	"license": "GPL-3.0",
	"icon": "assets/pgp-chat/icon.png",
	"environment": "*",
	"entrypoints": {
			"client": [
				"io.github.hankwly5.pgpchat.client.PgpChatClient"
			]
		},
	"mixins": [
		{
			"config": "pgp-chat.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
